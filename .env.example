# FajuARC — example environment
# Copy to .env and fill in. NEVER commit .env.
# All values below are placeholders.

# ─────────────────────────────────────────────────────────────────────────────
# Backend (server/)
# ─────────────────────────────────────────────────────────────────────────────

# Which Arc network the backend talks to. REQUIRED, no default: "mainnet" | "testnet".
# Every per-network secret below is read ONLY from its _MAINNET / _TESTNET name.
ARC_NETWORK=testnet

PORT=3002
# Allowed CORS origin (the frontend URL)
FRONTEND_URL=http://localhost:3000

# Circle Developer-Controlled Wallets
# Mainnet keys start with "LIVE_API_KEY:", testnet keys with "TEST_API_KEY:".
# Generate the entity secret with:  ARC_NETWORK=<net> node scripts/circle-setup-entity-secret.mjs
# Create the wallet set with:       ARC_NETWORK=<net> node scripts/create-wallet-set.mjs
CIRCLE_API_KEY_TESTNET=TEST_API_KEY:xxxxxxxx:xxxxxxxx
CIRCLE_ENTITY_SECRET_TESTNET=
CIRCLE_WALLET_SET_ID_TESTNET=
CIRCLE_API_KEY_MAINNET=LIVE_API_KEY:xxxxxxxx:xxxxxxxx
CIRCLE_ENTITY_SECRET_MAINNET=
CIRCLE_WALLET_SET_ID_MAINNET=

# Upstash Redis (persistent storage). Both networks may share one database;
# keys are namespaced as fajuarc:<network>:*
UPSTASH_REDIS_REST_URL_TESTNET=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN_TESTNET=
UPSTASH_REDIS_REST_URL_MAINNET=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN_MAINNET=

# Privy (server SDK). The App Secret must include the "privy_app_secret_" prefix.
PRIVY_APP_ID=
PRIVY_APP_SECRET=privy_app_secret_xxxxxxxx
# Authorization key for session signers (value starts with "wallet-auth:")
PRIVY_AUTHORIZATION_KEY=

# Who signs scheduled payments: "viem" (bot wallet below) or "privy" (user's wallet via session signer)
AUTOMATION_SIGNER=viem
# Private key of the bot wallet used when AUTOMATION_SIGNER=viem (0x + 64 hex)
AUTOMATION_PRIVATE_KEY_TESTNET=
AUTOMATION_PRIVATE_KEY_MAINNET=

# AI agent (Anthropic Claude)
ANTHROPIC_API_KEY=

# Optional: override the explorer API base URL
# ARCSCAN_API=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vite — every VITE_* value is PUBLIC, bundled into the browser)
# ─────────────────────────────────────────────────────────────────────────────

# Backend base URL
VITE_API_URL=http://localhost:3002
VITE_WALLETCONNECT_PROJECT_ID=
# Privy key quorum id used when adding session signers
VITE_PRIVY_KEY_QUORUM_ID=

# Optional overrides (defaults live in src/config/)
# VITE_CHAIN_ID=
# VITE_RPC_URL=
# VITE_DEX_FACTORY_ADDRESS=
# VITE_DEX_ROUTER_ADDRESS=
# VITE_DEX_PAIR_ADDRESS=
# VITE_FAJU_FARM_ADDRESS=
# VITE_V3_FACTORY=
# VITE_V3_SWAP_ROUTER=
# VITE_V3_POSITION_MANAGER=
# VITE_V3_QUOTER=

# ─────────────────────────────────────────────────────────────────────────────
# Contract deployment (Hardhat, scripts/deploy-*.cjs) — local use only
# ─────────────────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
# ARC_RPC_URL=https://rpc.testnet.arc.network
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
